# Koneksi OWNER — hanya untuk migrasi (DDL). Runtime aplikasi TIDAK boleh memakai ini.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:55432/aee

# Koneksi RUNTIME — login role yang diberi membership role aee_app (SELECT+INSERT saja).
# Pattern sama dengan temurute_app (lihat memory). aee_app sendiri NOLOGIN.
DATABASE_APP_URL=postgres://aee_runtime:CHANGE_ME@localhost:55432/aee

# Password Postgres kontainer DEV/scratch (dibuat oleh scripts/orch_reset.sh).
# §24: TIDAK ada kredensial literal di source — tooling lokal membaca var ini.
# Isi dengan nilai sama seperti DATABASE_URL saat memakai kontainer dev lokal.
AEE_DEV_DB_PASSWORD=CHANGE_ME

# ── Billing provider (default: duitku bila POLAR_* belum di-set) ────────────
# 'polar' memaksa Polar; 'duitku' memaksa Duitku; kosong → auto (polar bila set).
BILLING_PROVIDER=duitku

# Polar (polar.sh) — migrate dari Duitku. Buat di dashboard polar.sh:
#   Settings → Developers → Access tokens  (POLAR_ACCESS_TOKEN)
#   Settings → Webhooks → Endpoint          (POLAR_WEBHOOK_SECRET)
#   Products → buat 1 produk per plan, salin id-nya ke POLAR_PRODUCT_*.
# Semua wajib per PLAN price di router billing (server-side source of truth).
POLAR_ACCESS_TOKEN=***            # pol_xxx (org access token)
POLAR_WEBHOOK_SECRET=***          # whsec_xxx (server-to-server webhook secret)
POLAR_ORGANIZATION_SLUG=aurex
POLAR_PRODUCT_STARTER=***         # product id utk STARTER
POLAR_PRODUCT_GROWTH=***          # product id utk GROWTH
POLAR_PRODUCT_ENTERPRISE=***      # product id utk ENTERPRISE
POLAR_SANDBOX=true

# Duitku (legacy, retained sebagai fallback) — hapus bila sudah 100% Polar.
DUITKU_MERCHANT_CODE=***
DUITKU_API_KEY=***
DUITKU_SANDBOX=true
