# Koneksi OWNER — hanya untuk migrasi (DDL). Runtime aplikasi TIDAK boleh memakai ini.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:55432/aee

# Koneksi RUNTIME — login role yang diberi membership role aee_app (SELECT+INSERT saja).
# Pattern sama dengan temurute_app (lihat memory). aee_app sendiri NOLOGIN.
DATABASE_APP_URL=postgres://aee_runtime:CHANGE_ME@localhost:55432/aee
