#!/usr/bin/env bash
# Hook git post-push — auto-deploy ke Fly.io saat main di-push ke origin.
# Dipasang via: git config core.hooksPath .githooks  (repo-local)
# Deploy dijalankan di BACKGROUND — push selesai normal, deploy berjalan
# setelahnya; log: %LOCALAPPDATA%/Temp/fly-auto-deploy.log
# Pertama kali (fresh clone): git config core.hooksPath .githooks

# Baca stdin `git push` — format "<local> <remote> <ref>" per baris
while read -r local_ref local_sha remote_ref remote_sha; do
  # Hanya deploy saat branch main diperbarui di origin
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_ref" != "(delete)" ]; then
    ( bash scripts/auto-deploy-fly.sh ) &
    disown 2>/dev/null || true
    echo "[post-push] main diperbarui → auto-deploy Fly dimulai (background)."
    echo "[post-push] Log: $TMPD/fly-auto-deploy.log  (atau \$LOCALAPPDATA/Temp)"
  fi
done
exit 0
